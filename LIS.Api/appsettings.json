{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=LisDb;User Id=sa;Password=Your_strong_Pass123!;TrustServerCertificate=True;Encrypt=False"
  },
  "Jwt": {
    "Issuer": "LIS.Api",
    "Audience": "LIS.Client",
    "Key": "dev-only-super-secret-signing-key-change-me-32+chars!!",
    "ExpiryMinutes": 60
  },
  "RateLimiting": {
    "GlobalPermitPerMinute": 100,
    "LoginPermitPerMinute": 5
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/lis-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
